# Copy this file to .env and fill in real values. .env is git-ignored.

# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#    It gives you a token that looks like 123456789:AAExampleTokenTextHere
TELEGRAM_BOT_TOKEN=

# 2. Send any message to your new bot, then visit (in a browser, while it's
#    running) https://api.telegram.org/bot<TOKEN>/getUpdates and read the
#    "chat":{"id": ...} value from the JSON response. That number (can be
#    negative for a group) is your chat id.
TELEGRAM_CHAT_ID=
