{
  "info": {
    "_postman_id": "cronfetch-collection-v1",
    "name": "CronFetch",
    "description": "All CronFetch API endpoints. Import into Postman, then set base_url to your local or deployed URL. Signup/login save the token automatically; creating a company saves company_id automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "company_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"db is online\", () => pm.expect(pm.response.json().db).to.eql(\"online\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /signup",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Karthik\", \"email\": \"you@example.com\", \"password\": \"yourpassword123\"}"
            },
            "url": "{{base_url}}/signup"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"token\", pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"you@example.com\", \"password\": \"yourpassword123\"}"
            },
            "url": "{{base_url}}/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"token\", pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "POST /companies (Linear, Ashby)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Linear\", \"career_url\": \"https://jobs.ashbyhq.com/linear\", \"min_experience_years\": 2, \"max_experience_years\": 6, \"roles\": [\"engineer\"], \"locations\": [\"Remote\"]}"
            },
            "url": "{{base_url}}/companies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"company_id\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /companies (Valtech, own careers page)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Valtech\", \"career_url\": \"https://www.valtech.com/en-in/career/jobs/\", \"platform\": \"greenhouse\", \"board\": \"valtech\", \"roles\": [\"developer\", \"engineer\"], \"locations\": [\"India\"]}"
            },
            "url": "{{base_url}}/companies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/companies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /companies/{id} (change min experience)",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\"min_experience_years\": 5}"
            },
            "url": "{{base_url}}/companies/{{company_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /companies/{id}/jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/companies/{{company_id}}/jobs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has matched count\", () => pm.expect(pm.response.json()).to.have.property(\"total_matched\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
